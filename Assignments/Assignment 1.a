/*A company stores employee IDs in ascending order. Write a C program that accepts n employee
IDs, searches for a required ID using Binary Search, displays its position when found, reports
when it is absent, and counts the number of comparisons. Test the program for both successful
and unsuccessful searches.*/
#include <stdio.h>
int main() {
    int n, i, target;
    int low, high, mid;
    int comparisons = 0;
    int found = -1;
    printf("Enter number of employees: ");
    scanf("%d", &n);
    int id[n];
    printf("Enter employee IDs in ascending order:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &id[i]);
    }
    printf("Enter employee ID to search: ");
    scanf("%d", &target);
    low = 0;
    high = n - 1;
    while (low <= high) {
        mid = (low + high) / 2;
        comparisons++;
        if (id[mid] == target) {
            found = mid;
            break;
        }
        else if (target < id[mid]) {
            high = mid - 1;
        }
        else {
            low = mid + 1;
        }
    }
    if (found != -1) {
        printf("Employee ID %d found at position %d\n", target, found + 1);
    }
    else {
        printf("Employee ID %d is not present\n", target);
    }
    printf("Number of comparisons: %d\n", comparisons);
    return 0;
}
